# Servidor
PORT=3000

# Banco de dados (MySQL)
DB_NAME=abc
DB_USER=root
DB_PASSWORD=senai
DB_HOST=localhost
DB_PORT=3306

# Chave secreta do token de login (gere uma frase longa e aleatória)
TOKEN_SECRET=troque_por_uma_chave_aleatoria
# E-mail (código da verificação em duas etapas do login de admin)
# Sem SMTP_HOST, fora de produção, o código aparece no console do servidor.
# Para testar envio de verdade sem caixa real, dá para usar uma conta do Ethereal (ethereal.email).
SMTP_HOST= 
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Loja <nao-responda@exemplo.com>"

# Limite de requisições por IP a cada 15 minutos (opcional)
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_VERIFICAR=20
# RATE_LIMIT_REENVIAR=10

# Duração do login (opcional). A sessão de admin é mais curta de propósito.
# JWT_EXPIRES_IN=1d
# JWT_ADMIN_EXPIRES_IN=2h
